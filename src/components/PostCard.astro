---
import type { CollectionEntry } from 'astro:content'

import { cn, formatDate } from '@/utils'
import { getPostReadingTime, postUrl } from '@/utils/server'

interface Props {
  post: CollectionEntry<'blog'>
  class?: string
}

const { post, class: className } = Astro.props
const { data } = post
const date = data.updatedDate ?? data.publishDate
const minutesRead = getPostReadingTime(post)
---

<article class={cn('post-row not-prose group relative flex flex-col gap-2', className)}>
  <h2 class="font-serif text-xl font-semibold leading-snug transition-colors duration-200 group-hover:text-accent">
    <a href={postUrl(post.id)} data-astro-prefetch class="after:absolute after:inset-0">
      {data.draft && <span class="me-1 text-accent">[Draft]</span>}
      {data.title}
    </a>
  </h2>

  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-xs text-ink-soft">
    <time datetime={date.toISOString()} class="tabular-nums">
      {formatDate(date)}
    </time>
    <span aria-hidden="true">·</span>
    <span>{minutesRead} min read</span>
  </div>

  <p class="line-clamp-2 text-sm leading-relaxed text-ink-soft">{data.description}</p>
</article>
