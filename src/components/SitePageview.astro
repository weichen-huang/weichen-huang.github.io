---
import { config } from '@/site-config'

const server = config.pageview.server
const enabled = config.pageview.siteWide
// Fixed virtual path — one counter for the whole site (total PV).
const SITE_PATH = '/site-pv'
---

{
  server && enabled && (
    <span
      class="site-pv inline-flex items-center gap-1 text-xs"
      data-server={server}
      data-path={SITE_PATH}
    >
      <span class="site-pv-num" data-pageview-value aria-label="total visits">
        ···
      </span>
      <span class="site-pv-unit">total visits</span>
    </span>
  )
}

<script>
  import { updatePageview } from '@/utils/pageview'

  void updatePageview(document.querySelector<HTMLElement>('.site-pv'))
</script>
