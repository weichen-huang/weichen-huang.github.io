---
import '@unocss/reset/tailwind.css'
import '@/assets/styles/tokens.css'
import '@/assets/styles/global.css'

import BackToTop from '@/components/BackToTop.astro'
import ConsoleGreeting from '@/components/ConsoleGreeting.astro'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import Lightbox from '@/components/Lightbox.astro'
import { config } from '@/site-config'
import libronRegular from '@/assets/fonts/Libron-Regular.woff2?url'
import themeScript from '@/scripts/theme.js?raw'
import { withBase } from '@/utils'
import { THEME_COLORS, themeColorHex } from '@/utils/theme'

interface Props {
  home?: boolean
  title?: string
  description?: string
  /** ISO date of the page (for article meta) */
  date?: Date
  modifiedDate?: Date
  stylesheets?: string[]
  /** Path to an OG image (absolute, under public/) */
  ogImage?: string
  /** Disable page indexation */
  noindex?: boolean
}

const {
  home = false,
  title,
  description = config.site.description,
  date,
  modifiedDate,
  stylesheets = [],
  ogImage = config.site.ogImage,
  noindex = false
} = Astro.props

const fullTitle = title
  ? `${title}${config.site.titleDelimiter}${config.site.title}`
  : config.site.title
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com')
const ogUrl = new URL(withBase(ogImage), Astro.site ?? 'https://example.com')
---

<!doctype html>
<html
  lang={config.site.lang}
  class="scroll-smooth"
  data-bg-ink-light={THEME_COLORS.ink.light}
  data-bg-ink-dark={THEME_COLORS.ink.dark}
  data-bg-fresh-light={THEME_COLORS.fresh.light}
  data-bg-fresh-dark={THEME_COLORS.fresh.dark}
  data-default-theme={config.site.theme}
  data-default-palette={config.site.palette}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={withBase(config.site.favicon)} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon/favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('/favicon/favicon-16x16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/favicon/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/favicon/site.webmanifest')} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={themeColorHex(config.site.palette, false)} />
    <link rel="preload" href={libronRegular} as="font" type="font/woff2" crossorigin />
    {stylesheets.map((href) => (
      <link rel="stylesheet" href={href} />
    ))}

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={date ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:site_name" content={config.site.title} />
    <meta name="twitter:card" content="summary_large_image" />

    {date && <meta property="article:published_time" content={date.toISOString()} />}
    {date && modifiedDate && (
      <meta property="article:modified_time" content={modifiedDate.toISOString()} />
    )}

    <!-- Theme + palette controller: first paint, toggle clicks and OS changes -->
    <script is:inline set:html={themeScript} />
  </head>

  <body
    class:list={[
      'relative min-h-dvh bg-paper font-sans text-ink transition-colors duration-300',
      home && 'home-page'
    ]}
    data-astro-page
  >
    <div id="ambient" aria-hidden="true"></div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-50 focus:rounded-md focus:border focus:border-accent focus:bg-card focus:px-3 focus:py-2"
    >
      Skip to content
    </a>

    <div class="flex min-h-dvh flex-col">
      <Header />
      <div class:list={['flex w-full flex-1 flex-col', !home && 'mx-auto max-w-5xl px-5 sm:px-8']}>
        <main id="main" class:list={['flex-1 page-content', !home && 'py-16 sm:py-20']}>
          <slot />
        </main>
        <Footer />
      </div>
    </div>
    <BackToTop />
    <Lightbox />
    <ConsoleGreeting />
  </body>
</html>
