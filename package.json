{
  "name": "astro-theme-ink",
  "type": "module",
  "version": "0.3.0",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "A warm, paper-feel personal blog theme built with Astro & UnoCSS. Ink on paper.",
  "keywords": [
    "astro",
    "astro-theme",
    "blog",
    "personal-blog",
    "minimal",
    "unocss",
    "waline"
  ],
  "homepage": "https://willimt.github.io/astro-theme-ink/",
  "repository": {
    "type": "git",
    "url": "https://github.com/willimt/astro-theme-ink.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "theme:sync": "node scripts/theme-sync.mjs",
    "theme:sync:ui": "node scripts/theme-sync-panel.mjs",
    "format": "prettier --write .",
    "clean": "node -e \"['dist','.astro'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
    "optimize:avatar": "node scripts/optimize-avatar.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/lucide": "^1.2.0",
    "@unocss/astro": "^66.10.5",
    "@unocss/preset-icons": "^66.10.5",
    "@unocss/reset": "^66.10.5",
    "@waline/client": "^3.15.2",
    "astro": "^7.3.5",
    "katex": "^0.18.4",
    "mermaid": "^11.16.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "unocss": "^66.10.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@shikijs/core": "4.4.3",
    "@shikijs/types": "4.4.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.2.0",
    "@unocss/preset-typography": "^66.10.5",
    "hastscript": "^9.0.1",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^1.1.0",
    "shiki": "^4.4.3",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
